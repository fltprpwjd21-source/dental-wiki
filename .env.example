# ─────────────────────────────────────────────────────────────
# 치과위키 환경변수 견본 파일
#
# 사용법: 이 파일을 복사해 `.env` 를 만들고, 아래 각 항목에 실제 값을 채운다.
#   cp .env.example .env
#
# 주의
#   - `.env` 는 절대 GitHub에 올리지 않는다 (.gitignore에 등록되어 있음)
#   - `키=값` 사이에 띄어쓰기를 넣지 않는다. 따옴표도 붙이지 않는다
#   - 이 파일(.env.example)에는 절대 실제 값을 적지 않는다. 키 이름만 남긴다
# ─────────────────────────────────────────────────────────────


# ── 1. 앱 실행에 반드시 필요한 값 ─────────────────────────────
# 이 4개가 없으면 앱이 뜨지 않거나 Q&A가 동작하지 않는다.

# Supabase 프로젝트 주소 (https://<프로젝트ref>.supabase.co 형태)
# 위치: Supabase 대시보드 → Project Settings → Data API → Project URL
# 참고: NEXT_PUBLIC_ 접두사가 붙어 브라우저에 노출된다. 비밀값이 아니다
NEXT_PUBLIC_SUPABASE_URL=

# Supabase 서버 전용 키 (모든 권한. 절대 브라우저로 노출 금지)
# 위치: Supabase 대시보드 → Project Settings → API Keys → service_role / secret key
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI API 키 (문서 임베딩 생성 + Q&A 답변 생성에 사용)
# 위치: https://platform.openai.com/api-keys
# 필요 모델: text-embedding-3-small, gpt-4o-mini
OPENAI_API_KEY=

# 세션 쿠키 서명용 비밀키 (직접 정하는 값. 발급받는 것이 아님)
# 길수록 안전하다. 아래 명령으로 만들어 붙여넣으면 된다:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# 주의: 이 값을 바꾸면 기존에 로그인해 둔 사람들이 전부 로그아웃된다
SESSION_SECRET=


# ── 2. 로그인 정책 값 ─────────────────────────────────────────

# 전 직원 공통 로그인 비밀번호 (직접 정하는 값)
# 사원번호는 employee_whitelist 테이블에 등록된 것만 로그인이 허용된다
COMMON_LOGIN_PASSWORD=


# ── 3. 개발·배포 도구용 값 (앱 실행에는 불필요) ───────────────
# 없어도 `npm run dev` 는 정상 동작한다. CLI 작업을 할 때만 필요하다.

# Supabase CLI 인증 토큰 (supabase link, db push 등)
# 위치: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Supabase DB 직접 접속 비밀번호 (마이그레이션 적용 시 필요)
# 위치: Supabase 대시보드 → Project Settings → Database → Database password
#       기억나지 않으면 같은 화면에서 "Reset database password" 로 새로 발급
SUPABASE_DB_PASSWORD=

# Vercel 배포용 토큰
# 위치: https://vercel.com/account/tokens
VERCEL_TOKEN=

# GitHub 토큰 (저장소 push 등)
# 위치: GitHub → Settings → Developer settings → Personal access tokens
# 필요 권한(scope): repo
GITHUB_TOKEN=
