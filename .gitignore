# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 값이 비어있는 견본 파일은 커밋 허용
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# bkit plugin 로컬 세션 캐시 (커밋 불필요)
/.bkit/
