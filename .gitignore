# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 값이 비어있는 견본 파일은 커밋 허용
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# bkit plugin 로컬 세션 캐시 (커밋 불필요)
/.bkit/

# 작업 중 지운 파일을 임시로 모아두는 곳 (CLAUDE.md 규칙 — 바로 삭제하지 않는다)
trash-can/

# git worktree 작업 폴더 (커밋 대상이 아니다 — 안에 .next 빌드 산출물까지 들어 있다)
/.claude/worktrees/

# 개인용 Claude Code 권한 설정 (이 저장소는 공개라 커밋하지 않는다)
/.claude/settings.local.json
